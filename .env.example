# Google Gemini API Key (Get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Default Gemini model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Firebase Web SDK Config (for Auth & Firestore memo persistence)
# If omitted, ThesisLens automatically uses local browser storage so demos work out of the box.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
