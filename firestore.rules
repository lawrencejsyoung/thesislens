rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User-scoped investment memos (requires Firebase Authentication)
    match /users/{userId}/investment_memos/{memoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny unauthenticated access to legacy global collection by default.
    // Enable Firebase Auth and migrate writes to /users/{uid}/investment_memos before
    // storing sensitive portfolio data in Firestore.
    match /investment_memos/{memoId} {
      allow read, write: if false;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
